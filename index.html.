<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
    <title>Garden Match-3 & Venom Boutique</title>
    <script src="https://cdn.jsdelivr.net/npm/phaser@3.60.0/dist/phaser.min.js"></script>
    <style>
        body { margin: 0; padding: 0; background-color: #000; overflow: hidden; font-family: sans-serif; }
        canvas { display: block; margin: 0 auto; }
        
        /* AdMob Banner Placeholder */
        #ad-banner {
            position: absolute; bottom: 0; width: 100%; height: 50px;
            background: #000; color: #fff; display: flex; 
            align-items: center; justify-content: center; font-size: 12px; z-index: 10;
        }

        /* Marketplace Overlay */
        #marketplace {
            display: none; position: absolute; top: 0; left: 0; 
            width: 100%; height: 100%; background: rgba(255,240,245,0.95);
            z-index: 20; overflow-y: auto; padding: 20px; box-sizing: border-box;
        }
        .market-header { display: flex; justify-content: space-between; align-items: center; }
        .grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; margin-top: 20px; }
        .product-card { background: #fff; border-radius: 10px; padding: 10px; text-align: center; border: 1px solid #ffb6c1; }
        .buy-btn { background: #ff1493; color: #fff; border: none; padding: 8px; border-radius: 5px; width: 100%; cursor: pointer; }
    </style>
</head>
<body>

    <div id="ad-banner">Loading AdMob Banner...</div>

    <div id="marketplace">
        <div class="market-header">
            <h2 style="color: #d02090;">Venom Boutique</h2>
            <button onclick="toggleMarket(false)" style="padding: 10px;">Close</button>
        </div>
        <div class="grid" id="product-grid"></div>
    </div>

    <script>
    // --- MONETIZATION & OFFLINE LOGIC ---
    function autoRefreshBanner() {
        const adDiv = document.getElementById('ad-banner');
        if (!navigator.onLine) {
            adDiv.innerHTML = "<b>Check out Venom AI Chat - Works Offline!</b>";
            adDiv.style.background = "#d02090";
        } else {
            adDiv.innerHTML = "AdMob Banner Refreshed at " + new Date().toLocaleTimeString();
            adDiv.style.background = "#000";
        }
    }
    setInterval(autoRefreshBanner, 60000);

    function toggleMarket(show) {
        document.getElementById('marketplace').style.display = show ? 'block' : 'none';
    }

    // Load Marketplace Products
    const products = [
        { name: "Luxury Perfume", price: "₦15,000", img: "🌸" },
        { name: "Silk Scarf", price: "₦8,500", img: "🌷" },
        { name: "Gold Watch", price: "₦45,000", img: "🥚" },
        { name: "Floral Bag", price: "₦12,000", img: "🌹" }
    ];

    const grid = document.getElementById('product-grid');
    products.forEach(p => {
        grid.innerHTML += `
            <div class="product-card">
                <div style="font-size: 40px;">${p.img}</div>
                <p><b>TEMU</b></p>
                <p>${p.name}</p>
                <p style="color: green;">${p.price}</p>
                <button class="buy-btn" onclick="alert('Opening Secure Checkout...')">Buy</button>
            </div>
        `;
    });

    // --- GAME LOGIC (PHASER.JS) ---
    const config = {
        type: Phaser.AUTO,
        width: window.innerWidth,
        height: window.innerHeight - 50,
        backgroundColor: '#2d5a27',
        parent: 'phaser-game',
        scene: { preload: preload, create: create, update: update }
    };

    const game = new Phaser.Game(config);
    let items = ['🌹', '🌻', '🌺', '🌸', '🌷', '🥚', '🍎'];

    function preload() {}

    function create() {
        // Luxury Background
        this.add.text(config.width/2, config.height/2, "Secret Garden", { 
            fontSize: '32px', color: '#ffb6c1', alpha: 0.3 
        }).setOrigin(0.5);

        // Grid Creation
        const cellSize = config.width / 9;
        for (let r = 0; r < 8; r++) {
            for (let c = 0; c < 8; c++) {
                let randomFruit = items[Math.floor(Math.random() * items.length)];
                let tile = this.add.text(c * cellSize + 30, r * cellSize + 100, randomFruit, { fontSize: '30px' })
                    .setInteractive();
                
                tile.on('pointerdown', function() {
                    // Pollen Burst Effect
                    const emitter = this.scene.add.particles(tile.x, tile.y, 'pollen', {
                        speed: 100, scale: { start: 1, end: 0 }, blendMode: 'ADD', duration: 200
                    });
                    this.scene.cameras.main.shake(100, 0.01);
                    tile.destroy(); 
                });
            }
        }

        // Main Menu Button for Marketplace
        const shopBtn = this.add.text(config.width/2, 50, "🛍️ Open Venom Boutique", {
            fontSize: '20px', backgroundColor: '#d02090', padding: 10
        }).setOrigin(0.5).setInteractive();

        shopBtn.on('pointerdown', () => toggleMarket(true));
    }

    function update() {}
    </script>
</body>
</html>
